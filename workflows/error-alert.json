      "name": "Attorney numbers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $('Read settings').all().find(i => i.json.Key === 'Attorney WhatsApp numbers')?.json.Value ?? '';\nreturn String(raw).split(/[;,]/)\n  .map(p => p.split('=').pop().replace(/[^0-9]/g, ''))\n  .filter(Boolean)\n  .map(number => ({ json: { number } }));"
      }
    },
    {
      "id": "b7b89405-c9ff-9cb4-0a70-453acfc6af83",
      "name": "Alert attorneys",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        780,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v24.0/{{ $('Read settings').all().find(i => i.json.Key === 'WhatsApp phone number ID')?.json.Value }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.number, type: 'template', template: { name: 'system_alert', language: { code: 'en' }, components: [{ type: 'body', parameters: ([$('On error').first().json.workflow?.name ?? 'An agent', $('On error').first().json.execution?.lastNodeExecuted ?? 'unknown', String($('On error').first().json.execution?.error?.message ?? 'unknown error').slice(0, 200)]).map(t => ({ type: 'text', text: String(t).replace(/\\s+/g, ' ') })) }] } }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "BBCM WhatsApp"
        }
      }
    },
