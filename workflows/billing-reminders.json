        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.recipient, type: 'template', template: { name: 'payment_reminder', language: { code: 'en' }, components: [{ type: 'body', parameters: ([$json.recipientName, $json.firm, $json.invoiceNo, $json.amount, $json.due]).map(t => ({ type: 'text', text: String(t).replace(/\\s+/g, ' ') })) }] } }) }}",
        "options": {}
