    {
      "id": "a26b9b74-779f-01b0-4b15-7fe84ca0f28e",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('When called').first().json;\nconst rows = $('Read approvals').all().map(i => i.json);\nconst from = String(input.from ?? '');\nif (input.kind === 'button') {\n  const [id, action] = String(input.payload ?? '').split('|');\n  const row = rows.find(r => r.ApprovalID === id);\n  if (!row || !['pending', 'editing'].includes(row.Status)) return [{ json: { route: 2 } }];\n  if (action === 'edit') return [{ json: { route: 1, id, from } }];\n  const decision = action === 'approve' ? 'approved' : 'rejected';\n  return [{ json: { route: 0, id, from, decision, text: row['Draft text'], resumeUrl: row['Resume URL'] } }];\n}\nconst now = new Date();\nconst editing = rows.find(r =>\n  r.Status === 'editing' && String(r['Decided by']) === from && new Date(r['Edit until']) > now);\nif (!editing) return [{ json: { route: 2 } }];\nreturn [{ json: { route: 0, id: editing.ApprovalID, from, decision: 'edited', text: String(input.text ?? ''), resumeUrl: editing['Resume URL'] } }];"
      }
    },
