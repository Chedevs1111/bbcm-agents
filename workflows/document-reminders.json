    {
      "id": "8d8d3b35-b199-d212-24bc-770a8a7323d0",
      "name": "Due reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const settings = Object.fromEntries($('Read settings').all().map(i => [i.json.Key, String(i.json.Value ?? '')]));\nconst digits = s => String(s ?? '').replace(/[^0-9]/g, '');\nconst firm = (settings['Firm name'] || 'our firm').replace(/\\.$/, '');\nconst attorneyNumber = digits((settings['Attorney WhatsApp numbers'] || '').split(/[;,]/)[0].split('=').pop());\nconst now = Date.now();\nreturn $('Read matters').all().map(i => i.json)\n  .filter(m => m.MatterID && m.Status !== 'closed' && String(m['Outstanding items'] ?? '').trim())\n  .map(m => ({ m, daysSince: m['Last client update'] ? (now - new Date(m['Last client update']).getTime()) / 86400000 : Infinity }))\n  .filter(({ m, daysSince }) => Number(m['Reminders sent'] || 0) < 4 && daysSince >= 3)\n  .map(({ m }) => ({ json: {\n    ...m, firm, attorneyNumber, agent: 'Document reminders', matterId: m.MatterID,\n    recipient: digits(m['Client WhatsApp']), recipientName: m['Client name'],\n    draft: `Document reminder to ${m['Client name']}: still needed — ${m['Outstanding items']}`,\n  } }));"
      }
    },
    {
      "id": "49307658-3c35-1cd2-df35-144a9a9c4ddc",
      "name": "Auto-send on?",
      "type": "n8n-nodes-base.if",
