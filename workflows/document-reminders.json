          "conditions": [
            {
              "id": "e8792c28-eb58-21ef-3c0a-b1d27b9e5c1f",
              "leftValue": "={{ $('Read settings').all().find(i => i.json.Key === 'Auto-send document reminders')?.json.Value === 'Yes' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
