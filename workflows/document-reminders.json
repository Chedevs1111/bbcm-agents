        "url": "=https://graph.facebook.com/v24.0/{{ $('Read settings').all().find(i => i.json.Key === 'WhatsApp phone number ID')?.json.Value }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.recipient, type: 'template', template: { name: 'document_reminder', language: { code: 'en' }, components: [{ type: 'body', parameters: ([$json.recipientName, $json.firm, $json['Outstanding items']]).map(t => ({ type: 'text', text: String(t).replace(/\\s+/g, ' ') })) }] } }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "BBCM WhatsApp"
        }
      }
