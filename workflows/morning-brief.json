        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.recipient, type: 'template', template: { name: 'morning_brief', language: { code: 'en' }, components: [{ type: 'body', parameters: ($json.params).map(t => ({ type: 'text', text: String(t).replace(/\\s+/g, ' ') })) }] } }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "BBCM WhatsApp"
        }
      }
