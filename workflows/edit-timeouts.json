    {
      "id": "65b68bea-5184-50bb-f2d7-885665a62824",
      "name": "Find lapsed edits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = new Date();\nreturn $('Read approvals').all()\n  .map(i => i.json)\n  .filter(r => r.Status === 'editing' && new Date(r['Edit until']) <= now)\n  .map(r => ({ json: r }));"
      }
    },
    {
      "id": "5dbafaf5-e719-fc97-a34a-9712f06ab50f",
      "name": "Back to pending",
