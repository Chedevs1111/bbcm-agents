    {
      "id": "4d2da9fe-d0e3-a6db-01e8-c8f751ef0b9a",
      "name": "Ask attorney again",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v24.0/{{ $('Read settings').all().find(i => i.json.Key === 'WhatsApp phone number ID')?.json.Value }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $('Find lapsed edits').item.json['Decided by'], type: 'template', template: { name: 'approval_request', language: { code: 'en' }, components: [{ type: 'body', parameters: ([$('Find lapsed edits').item.json.Agent, $('Find lapsed edits').item.json.Recipient, $('Find lapsed edits').item.json['Draft text']]).map(t => ({ type: 'text', text: String(t).replace(/\\s+/g, ' ') })) }, ...(['approve', 'edit', 'reject'].map(a => $('Find lapsed edits').item.json.ApprovalID + '|' + a)).map((p, i) => ({ type: 'button', sub_type: 'quick_reply', index: String(i), parameters: [{ type: 'payload', payload: p }] }))] } }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "BBCM WhatsApp"
        }
      }
    },
    {
      "id": "f38d192b-ee47-1e57-9029-e0a747ad83f3",
