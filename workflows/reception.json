    {
      "id": "4ea5d856-80ec-e2d6-a38b-334bf43487e8",
      "name": "Understand enquiry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5-5', max_tokens: 1024, system: \"You are the reception assistant of a South African law firm. Read the WhatsApp message and reply with JSON only: {\\\"name\\\": string|null, \\\"matterType\\\": string, \\\"summary\\\": string, \\\"opposingParty\\\": string|null, \\\"wantsAdvice\\\": boolean, \\\"asksFees\\\": boolean, \\\"pickedSlot\\\": 1|2|3|null}. wantsAdvice is true when they ask what they should do legally. Never give legal advice.\", messages: [{ role: 'user', content: String($('When called').first().json.text) }] }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "BBCM Anthropic"
        }
      }
    },
    {
      "id": "48a6dbcd-b104-3fa7-ef23-60cd68dffda9",
      "name": "Plan reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('When called').first().json;\nconst settings = Object.fromEntries($('Read settings').all().map(i => [i.json.Key, String(i.json.Value ?? '')]));\nlet ai = {};\ntry { ai = JSON.parse($('Understand enquiry').first().json.content[0].text); } catch { ai = { summary: input.text, wantsAdvice: true }; }\nconst low = s => String(s ?? '').toLowerCase().trim();\nconst names = [low(ai.name), low(ai.opposingParty)].filter(Boolean);\nconst conflict = $('Read matters').all().some(i => names.some(n => n && (low(i.json['Client name']) === n || low(i.json['Opposing party']) === n)));\nconst firm = (settings['Firm name'] || 'our firm').replace(/\\.$/, '');\nconst attorneyNumber = (settings['Attorney WhatsApp numbers'] || '').split(/[;,]/)[0].split('=').pop().replace(/[^0-9]/g, '');\nconst offered = $('Read enquiries').all().map(i => i.json).filter(r => String(r.WhatsApp) === input.from && r.Status === 'slots offered').pop();\nif (offered && ai.pickedSlot) {\n  const slot = String(offered['Consultation slot']).split(' | ')[ai.pickedSlot - 1];\n  if (slot) {\n    const start = new Date(slot);\n    const end = new Date(start.getTime() + 60 * 60 * 1000);\n    return [{ json: { ...ai, from: input.from, conflict, booking: { start: start.toISOString(), end: end.toISOString() },\n      slots: slot, status: 'booked', agent: 'Reception', matterId: '', recipient: input.from, recipientName: ai.name || 'client', attorneyNumber,\n      draft: `This is the digital assistant of ${firm}. Your consultation is booked for ${start.toLocaleString('en-ZA', { timeZone: 'Africa/Johannesburg', weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}. Please bring your ID.` } }];\n  }\n}\nconst busy = $('Read diary').all().map(i => i.json).filter(e => e.start).map(e => [new Date(e.start.dateTime || e.start.date), new Date(e.end.dateTime || e.end.date)]);\n// $now is in the workflow's Africa/Johannesburg zone; the server clock may be UTC.\nconst times = String(settings['Consultation slot rules'] ?? '').match(/\\b\\d{1,2}:\\d{2}\\b/g) ?? ['09:00', '11:00', '14:00'];\nconst slots = [];\nlet day = $now.startOf('day');\nwhile (slots.length < 3) {\n  day = day.plus({ days: 1 });\n  if (day.weekday > 5) continue;\n  for (const time of times) {\n    const [hour, minute] = time.split(':').map(Number);\n    const start = day.set({ hour, minute }).toJSDate();\n    const end = new Date(start.getTime() + 60 * 60 * 1000);\n    if (!busy.some(([s, e]) => s < end && e > start) && slots.length < 3) slots.push(start);\n  }\n}\nconst fmt = d => d.toLocaleString('en-ZA', { timeZone: 'Africa/Johannesburg', weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });\nconst draft = `This is the digital assistant of ${firm}. Thank you${ai.name ? ', ' + ai.name : ''} — we can see you for a free consultation. Reply 1, 2 or 3: ` +\n  slots.map((s, i) => `${i + 1}) ${fmt(s)}`).join('; ') + '. An attorney will answer any legal questions at the consultation.';\nreturn [{ json: { ...ai, from: input.from, conflict, booking: null, slots: slots.map(s => s.toISOString()).join(' | '), status: 'slots offered',\n  agent: 'Reception', matterId: '', recipient: input.from, recipientName: ai.name || 'client', attorneyNumber, draft } }];"
      }
    },
