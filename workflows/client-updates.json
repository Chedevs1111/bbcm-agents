    {
      "id": "362bae04-42fb-6a25-132e-6c67d6767e45",
      "name": "Answer from file",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1300,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5-5', max_tokens: 1024, system: \"You are the digital assistant of a South African law firm replying to an existing client on WhatsApp. Answer ONLY from the matter stage and next step provided. Never give legal advice. If the question needs advice or anything not in those facts, set routine to false. Reply with JSON only: {\\\"reply\\\": string, \\\"routine\\\": boolean}.\", messages: [{ role: 'user', content: String(JSON.stringify({ question: $('Find matter').first().json.text, stage: $('Find matter').first().json.Stage, nextStep: $('Find matter').first().json['Next step'] })) }] }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "BBCM Anthropic"
        }
      }
    },
    {
      "id": "97e09d8b-272d-ee67-3636-2a8a0eb0ff59",
      "name": "Draft answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const m = $('Find matter').first().json;\nlet ai = {};\ntry { ai = JSON.parse($('Answer from file').first().json.content[0].text); } catch { ai = { reply: '', routine: false }; }\nreturn [{ json: { ...m, routine: ai.routine === true,\n  draft: `This is the digital assistant of ${m.firm}. ${ai.reply || 'An attorney will reply to you shortly.'}` } }];"
      }
    },
