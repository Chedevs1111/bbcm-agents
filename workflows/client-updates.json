    {
      "id": "5d5bd8ba-0fc4-ccb9-be74-e28f902472b9",
      "name": "Draft receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const m = $('Find matter').first().json;\nconst items = String(m['Outstanding items'] ?? '').split(',').map(s => s.trim()).filter(Boolean);\nconst remaining = items.length === 1 ? '' : items.join(', ');\nreturn [{ json: { ...m, remaining, routine: true,\n  draft: `This is the digital assistant of ${m.firm}. Thank you — we have received your document and filed it with your matter.` } }];"
      }
    },
