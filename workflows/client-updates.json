    {
      "id": "0a4c077a-765b-dfc5-3ec6-ef55e1f98233",
      "name": "Find matter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('When called').first().json;\nconst settings = Object.fromEntries($('Read settings').all().map(i => [i.json.Key, String(i.json.Value ?? '')]));\nconst digits = s => String(s ?? '').replace(/[^0-9]/g, '');\nconst matter = $('Read matters').all().map(i => i.json)\n  .filter(m => digits(m['Client WhatsApp']) === input.from && m.Status !== 'closed').pop() ?? {};\nreturn [{ json: {\n  ...matter, ...input,\n  firm: (settings['Firm name'] || 'our firm').replace(/\\.$/, ''),\n  attorneyNumber: digits((settings['Attorney WhatsApp numbers'] || '').split(/[;,]/)[0].split('=').pop()),\n  isMedia: input.kind === 'media' && Boolean(input.mediaId),\n  agent: 'Client updates', matterId: matter.MatterID ?? '', recipient: input.from, recipientName: matter['Client name'] ?? 'client',\n} }];"
      }
    },
